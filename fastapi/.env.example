
# Postgres connection string used by the ETL (and, after PR-E, by FastAPI
# itself). Use the Supabase "Transaction pooler" string on port 6543 for
# scripts and short-lived requests; the "Session" string on 5432 is fine
# for long-running migrations.
#
POSTGRES_URL=

# Filesystem root of per-run ML artifacts produced by `geomarketia-train`.
# The API expects the layout: <ARTIFACTS_DIR>/runs/<db_key>/{data,models,reports}/...
# Relative paths resolve from the `fastapi/` folder, not the process CWD.
# Defaults to `<fastapi>/artifacts/`. Point at the sibling training
# checkout for local development:
#
# ARTIFACTS_DIR=./artifacts
ARTIFACTS_DIR=

